# Copy this file to .env and fill in ONE key (or more). Never commit .env.

# Which provider to use by default: anthropic | openai | deepseek | mistral
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Optional: override the default model for a provider
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6-astra
# DEEPSEEK_MODEL=deepseek-v4-pro
# MISTRAL_MODEL=mistral-large-latest

# Optional: port for the local web page (npm start)
# PORT=8787
